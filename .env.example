# ==========================================================================
# GovTrans environment template.
# Copy to `.env` and fill real values. `.env` is gitignored — NEVER commit it.
# No real key may ever appear in source, tests, fixtures, prompts, frontend,
# or logs. See docs/SECURITY.md.
# ==========================================================================

# --- Runtime ---
GOVTRANS_ENV=development          # development | test | production
LOG_LEVEL=INFO
# When false (default for CONFIDENTIAL runs), raw source text / prompts are
# NOT written to logs. Set true only for local debugging.
GOVTRANS_LOG_RAW_CONTENT=false

# --- LLM provider (OpenAI-compatible, e.g. DashScope) ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=                # REQUIRED at startup, no default, never logged

# --- Models (all configurable; no model name is hard-coded in source) ---
TRANSLATOR_MODEL=qwen-plus
REVIEW_MODEL=qwen-max
FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank-v2

# --- ToFu agent runtime (independent service; GovTrans talks HTTP/SSE to it) ---
TOFU_BASE_URL=http://localhost:15000
TOFU_TIMEOUT_SECONDS=120

# --- Database (PostgreSQL + pgvector in docker; SQLite allowed for local dev) ---
# docker:  postgresql+psycopg2://govtrans:govtrans@localhost:5432/govtrans
DATABASE_URL=sqlite:///./data/govtrans.db

# --- Redis (event bus / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=govtrans
S3_SECRET_KEY=change-me-in-.env
S3_BUCKET=govtrans-corpus

# --- tofu-search (official web research; see docs/SECURITY.md for allowlist) ---
# SEARCH_BACKEND=bing
# BING_SEARCH_KEY=
