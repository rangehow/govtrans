# ==========================================================================
# GovTrans environment template.
# Copy to `.env` and fill real values. `.env` is gitignored — NEVER commit it.
# No real key may ever appear in source, tests, fixtures, prompts, frontend,
# or logs. See docs/SECURITY.md.
# ==========================================================================

# --- Runtime ---
GOVTRANS_ENV=development          # development | test | production
LOG_LEVEL=INFO
# When false (default for CONFIDENTIAL runs), raw source text / prompts are
# NOT written to logs. Set true only for local debugging.
GOVTRANS_LOG_RAW_CONTENT=false

# --- LLM provider (OpenAI-compatible, e.g. DashScope) ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=                # REQUIRED at startup, no default, never logged

# --- Models (all configurable; no model name is hard-coded in source) ---
TRANSLATOR_MODEL=qwen-plus
REVIEW_MODEL=qwen-max
FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank-v2

# --- ToFu agent runtime (independent service; GovTrans talks HTTP/SSE to it) ---
TOFU_BASE_URL=http://localhost:15001
# Optional for a trusted loopback ToFu. Required by the bundled Docker sidecar.
TOFU_API_KEY=
TOFU_TIMEOUT_SECONDS=600
TOFU_MAX_RETRIES=6
# Shared across all runs in one API process; keep below the ToFu admission cap.
TOFU_MAX_CONCURRENCY=12
# A full ToFu instance is treated as a bounded queue, separately from network retries.
TOFU_ADMISSION_TIMEOUT_SECONDS=30
# After a bounded admission attempt, persist the waiting state and retry the
# idempotent pipeline stage automatically at this interval.
TOFU_RESOURCE_RETRY_SECONDS=15
# Stop visibly waiting forever if the shared runtime remains unavailable.
TOFU_RESOURCE_MAX_WAITS=3
# Persist a real liveness event while a long stage is still awaiting its
# result. This never increments the percentage by itself.
RUN_PROGRESS_HEARTBEAT_SECONDS=8
# Use the same configured provider directly when ToFu refuses admission or an
# accepted task exceeds the bounded TOFU_TIMEOUT_SECONDS wait.
DIRECT_LLM_FALLBACK_ON_OVERLOAD=true

# --- SCIO official corpus crawler ---
# The Chinese white-paper site uses a JavaScript proof-of-work challenge.
# GovTrans completes it in an isolated Chromium session automatically. Docker
# installs all required libraries. Only unusual local runtimes need to point
# this optional value at their Chromium shared-library directories.
# SCIO_BROWSER_LIBRARY_PATH=/path/to/usr/lib64:/path/to/lib64

# --- Translation pipeline ---
# Blocking QA findings are repaired automatically up to this many rounds.
# A run that still fails is closed as QUALITY_GATE_FAILED; it never pauses for
# per-task human approval, and only COMPLETED runs can be exported.
MAX_FINALIZE_LOOPS=3
SEGMENT_MAX_CHARS=4000
# Normal documents fitting this budget are translated in one coherent call.
TRANSLATION_BATCH_MAX_CHARS=12000
# Short documents overlap translation with analysis/terminology instead of
# waiting for all preflight work to finish first. Set 0 to disable.
EARLY_TRANSLATION_MAX_CHARS=2500
# Used only by the explicit "balanced" mode; coherent mode is sequential.
TRANSLATION_BATCH_CONCURRENCY=3
DOCUMENT_CONTEXT_MAX_CHARS=40000
REVIEW_CONCURRENCY=8
RESEARCH_CONCURRENCY=4
MAX_TERM_CANDIDATES=24
# Only the highest-value terms fan out to official web research per run.
MAX_OFFICIAL_SEARCH_TERMS=4

# --- Database (PostgreSQL + pgvector in docker; SQLite allowed for local dev) ---
# docker:  postgresql+psycopg2://govtrans:govtrans@localhost:5432/govtrans
DATABASE_URL=sqlite:///./data/govtrans.db

# --- Reserved optional infrastructure (not required by the current Compose path) ---
REDIS_URL=redis://localhost:6379/0

# These S3-compatible settings are retained for future object-storage adapters.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=govtrans
S3_SECRET_KEY=change-me-in-.env
S3_BUCKET=govtrans-corpus

# --- tofu-search (official web research; see docs/SECURITY.md for allowlist) ---
# SEARCH_BACKEND=bing
# BING_SEARCH_KEY=
