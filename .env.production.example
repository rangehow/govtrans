# GovTrans production deployment template.
# Run `./scripts/deploy.sh init`; it copies this file to `.env` and replaces
# the two generated-secret placeholders. Then set DASHSCOPE_API_KEY.

GOVTRANS_ENV=production
LOG_LEVEL=INFO
GOVTRANS_LOG_RAW_CONTENT=false

# Public listener. Set GOVTRANS_BIND_ADDRESS=127.0.0.1 for local-only access.
GOVTRANS_BIND_ADDRESS=0.0.0.0
GOVTRANS_PORT=8080
API_PORT=8100
TOFU_PORT=15001

# Upstream OpenAI-compatible provider.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-with-your-real-dashscope-key
TRANSLATOR_MODEL=qwen-plus
REVIEW_MODEL=qwen-max
FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank-v2

# Generated by scripts/deploy.sh. Hex values are URL-safe in DATABASE_URL.
POSTGRES_USER=govtrans
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
POSTGRES_DB=govtrans
TOFU_API_KEY=GENERATE_TOFU_API_KEY

# Internal runtime limits and recovery.
TOFU_TIMEOUT_SECONDS=600
TOFU_MAX_RETRIES=6
TOFU_MAX_CONCURRENCY=6
TOFU_ADMISSION_TIMEOUT_SECONDS=30
TOFU_RESOURCE_RETRY_SECONDS=15
TOFU_RESOURCE_MAX_WAITS=3
TOFU_MEMORY_LIMIT=4g
TOFU_PIDS_LIMIT=512
RUN_PROGRESS_HEARTBEAT_SECONDS=8
DIRECT_LLM_FALLBACK_ON_OVERLOAD=true

# Translation pipeline.
MAX_FINALIZE_LOOPS=3
SEGMENT_MAX_CHARS=4000
TRANSLATION_BATCH_MAX_CHARS=12000
EARLY_TRANSLATION_MAX_CHARS=2500
TRANSLATION_BATCH_CONCURRENCY=3
DOCUMENT_CONTEXT_MAX_CHARS=40000
REVIEW_CONCURRENCY=8
RESEARCH_CONCURRENCY=4
MAX_TERM_CANDIDATES=24
MAX_OFFICIAL_SEARCH_TERMS=4

# Optional package mirror for restricted networks.
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
